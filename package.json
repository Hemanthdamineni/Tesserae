{
  "name": "toolbench",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Toolbench - a fast, privacy-first collection of browser utilities. Every tool runs entirely on your device; nothing is uploaded.",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/vendor-heif-wasm.mjs --check && node scripts/vendor-tesseract.mjs --check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,astro,css,md}\" \"*.{mjs,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,astro,css,md}\" \"*.{mjs,json,md}\"",
    "docs:tools": "node scripts/gen-tools-doc.mjs",
    "docs:check": "node scripts/gen-tools-doc.mjs && git diff --exit-code -- docs/TOOLS.md docs/TOOLS.md.csv",
    "bundle:check": "node scripts/check-bundle.mjs",
    "vendor:heif": "node scripts/vendor-heif-wasm.mjs",
    "vendor:tesseract": "node scripts/vendor-tesseract.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --grep-invert deep-audit",
    "test:audit": "playwright test --grep deep-audit",
    "verify": "npm run check && npm run lint && npm run format:check && npm run test && npm run build && npm run bundle:check && npm run test:e2e",
    "test:e2e:webkit": "docker run --rm --ipc=host --shm-size=1g -v \"$PWD:/work\" -w /work -e BASE_PATH=/ mcr.microsoft.com/playwright:v1.64.1-noble bash -lc \"npx playwright test --project=mobile-safari\""
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@huggingface/transformers": "^4.3.1",
    "@jitsi/rnnoise-wasm": "^0.2.1",
    "@jspawn/qpdf-wasm": "^0.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/deu": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/fra": "^1.0.0",
    "@tesseract.js-data/hin": "^1.0.0",
    "@tesseract.js-data/ita": "^1.0.0",
    "@tesseract.js-data/nld": "^1.0.0",
    "@tesseract.js-data/por": "^1.0.0",
    "@tesseract.js-data/rus": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "astro": "^7.4.4",
    "bcryptjs": "^3.0.3",
    "compromise": "^14.17.0",
    "cronstrue": "^3.24.0",
    "csso": "^5.0.5",
    "diff": "^5.2.2",
    "fflate": "^0.8.2",
    "gifenc": "^1.0.3",
    "html-minifier-terser": "^7.2.0",
    "jsqr": "^1.4.0",
    "libheif-js": "^1.23.5",
    "marked": "^14.1.4",
    "mediabunny": "^1.65.0",
    "mermaid": "^12.2.0",
    "openpgp": "^6.3.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "prettier": "^3.9.6",
    "qrcode-generator": "^2.0.4",
    "shiki": "^4.5.0",
    "sql.js": "^1.15.1",
    "sucrase": "^3.35.1",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "tesseract.js": "^7.0.0",
    "xlsx": "file:vendor/tarballs/xlsx-0.20.3.tgz",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/diff": "^5.2.3",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^5.1.0",
    "astro-eslint-parser": "^3.2.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "jsdom": "^25.0.1",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
