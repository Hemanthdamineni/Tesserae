---
import '@/styles/global.css';
import BaseHead from './BaseHead.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import SearchDialog from './SearchDialog.astro';
import DesignLab from './DesignLab.astro';
import { site } from '@/lib/site';

interface Props {
  title: string;
  description?: string;
  path?: string;
  noindex?: boolean;
  jsonLd?: (Record<string, unknown> | null)[];
  ogType?: 'website' | 'article';
  /** Constrain <main> to the reading column. */
  narrow?: boolean;
}

const { narrow = false, ...head } = Astro.props;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <BaseHead {...head} />
    {
      import.meta.env.DEV && (
        <script is:inline>
          // Design Lab pre-paint — compact mirror of src/lib/design-lab.ts: put the
          // persisted (or ?accent= link) accent on <html> before first paint.
          (function () {
            var ch;
            try {
              ch = JSON.parse(localStorage.getItem('tb-lab') || 'null');
            } catch (e) {
              ch = null;
            }
            if (!ch) return;
            var q = new URLSearchParams(location.search);
            var raw = q.get('accent') || ch.accent;
            if (!raw) return;
            var hex = String(raw).replace('#', '');
            if (hex.length === 3) hex = hex.replace(/./g, function (c) { return c + c; });
            var rgb = [0, 2, 4].map(function (i) {
              return parseInt(hex.slice(i, i + 2), 16);
            });
            if (rgb.some(isNaN)) return;
            var INK = [30, 30, 28], PAPER = [253, 251, 246];
            function lum(c) {
              function f(x) {
                x /= 255;
                return x <= 0.04045 ? x / 12.92 : Math.pow((x + 0.055) / 1.055, 2.4);
              }
              return 0.2126 * f(c[0]) + 0.7152 * f(c[1]) + 0.0722 * f(c[2]);
            }
            function ct(a, b) {
              var x = lum(a), y = lum(b);
              return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05);
            }
            function mx(a, b, t) {
              return a.map(function (v, i) {
                return Math.round(v + (b[i] - v) * t);
              });
            }
            function derive(a, bg) {
              return {
                a: a.join(' '),
                s: mx(a, [0, 0, 0], 0.22).join(' '),
                o: mx(a, bg, 0.86).join(' '),
                f: (ct(a, INK) >= ct(a, PAPER) ? INK : PAPER).join(' '),
              };
            }
            function write(v, suf) {
              var st = document.documentElement.style;
              st.setProperty('--lab-accent' + suf, v.a);
              st.setProperty('--lab-accent-strong' + suf, v.s);
              st.setProperty('--lab-accent-soft' + suf, v.o);
              st.setProperty('--lab-accent-fg' + suf, v.f);
            }
            write(derive(rgb, [248, 244, 235]), '');
            var dark = rgb;
            for (var i = 0; i < 4 && ct(dark, [21, 21, 19]) < 3; i++) dark = mx(dark, [255, 255, 255], 0.16);
            write(derive(dark, [21, 21, 19]), '-dark');
          })();
        </script>
      )
    }
    <slot name="head" />
  </head>
  <body class="min-h-dvh">
    <a href="#main" class="sr-only-focusable btn btn-primary fixed left-3 top-3 z-50">
      Skip to content
    </a>

    <Header />

    <main
      id="main"
      class:list={['mx-auto w-full px-4 py-8 sm:px-6', narrow ? 'max-w-3xl' : 'max-w-content']}
    >
      <slot />
    </main>

    <Footer />
    <SearchDialog />
    {import.meta.env.DEV && <DesignLab />}

    <div
      id="toast"
      class="pointer-events-none fixed inset-x-0 bottom-4 z-50 flex flex-col items-center gap-2"
      aria-live="polite"
      aria-atomic="true"
    >
    </div>

    <script>
      // Tiny toast helper available to any island via `window.toast(msg)`.
      (window as unknown as { toast: (m: string, kind?: string) => void }).toast = (
        message: string,
        kind: string = 'info',
      ) => {
        const host = document.getElementById('toast');
        if (!host) return;
        const el = document.createElement('div');
        el.role = 'status';
        el.className =
          'pointer-events-auto rounded-lg border px-4 py-2 text-sm shadow-lg animate-slide-up';
        el.style.backgroundColor = 'rgb(var(--bg))';
        if (kind === 'error') el.style.borderColor = 'rgb(var(--danger))';
        el.textContent = message;
        host.appendChild(el);
        setTimeout(() => {
          el.style.transition = 'opacity .3s';
          el.style.opacity = '0';
          setTimeout(() => el.remove(), 320);
        }, 2600);
      };
    </script>

    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          // The SW lives at the deploy base (e.g. /Tesserae) or the site root.
          const base = import.meta.env.BASE_URL.replace(/\/$/, '');
          navigator.serviceWorker.register(`${base}/sw.js`).catch(() => {
            /* offline support is a progressive enhancement */
          });
        });
      }
    </script>
  </body>
</html>
