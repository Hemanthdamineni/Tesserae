---
import type { ToolMeta } from '@/lib/types';
import { CATEGORIES } from '@/lib/categories';
import { getContent } from '@/lib/content';
import { relatedTools } from '@/lib/registry';
import Icon from './Icon.astro';
import PrivacyBadge from './PrivacyBadge.astro';
import PrivacyBanner from './PrivacyBanner.astro';
import TextWorkbench from './workbench/TextWorkbench.astro';
import FileWorkbench from './workbench/FileWorkbench.astro';
import CameraPanel from './workbench/CameraPanel.astro';
import PanelWorkbench from './workbench/PanelWorkbench.astro';
import SignatureWorkbench from './workbench/SignatureWorkbench.astro';
import ToolCard from './ToolCard.astro';

interface Props {
  meta: ToolMeta;
}
const { meta } = Astro.props;
const content = getContent(meta.id);
const article = content?.article;
const faq = content?.faq;
const category = CATEGORIES[meta.category];
const related = relatedTools(meta);
// Link paths must honour the deploy base (e.g. /Tesserae on GitHub Pages).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<article
  class="mx-auto max-w-4xl"
  data-tool-id={meta.id}
  data-tool-name={meta.name}
  data-tool-href={`${base}/tools/${meta.id}`}
>
  <nav
    class="flex flex-wrap items-center gap-1.5 text-sm text-[rgb(var(--text-muted))]"
    aria-label="Breadcrumb"
  >
    <a class="transition-colors hover:text-[rgb(var(--accent))]" href={`${base}/tools`}>Tools</a>
    <Icon name="chevron-right" size={14} class="shrink-0" />
    <a
      class="transition-colors hover:text-[rgb(var(--accent))]"
      href={`${base}/categories/${category.id}`}>{category.name}</a
    >
    <Icon name="chevron-right" size={14} class="shrink-0" />
    <span class="truncate text-[rgb(var(--text))]">{meta.name}</span>
  </nav>

  <header class="mt-5">
    <div class="flex flex-wrap items-center gap-2">
      <span class="chip">
        <Icon name={category.icon} size={14} />
        {category.name}
      </span>
      {meta.status === 'beta' && <span class="chip">Beta</span>}
    </div>
    <h1 class="mt-3 text-2xl font-semibold tracking-[-0.02em] text-[rgb(var(--text))] sm:text-3xl">
      {meta.name}
    </h1>
    <p class="mt-2 max-w-prose leading-relaxed text-[rgb(var(--text-muted))]">{meta.description}</p>
    <div class="mt-4"><PrivacyBadge privacy={meta.privacy} /></div>
  </header>

  <div class="mt-6">
    <PrivacyBanner privacy={meta.privacy} />
  </div>

  <div class="mt-6">
    {meta.camera && <CameraPanel meta={meta} />}
    {
      meta.panel === 'signature' ? (
        <SignatureWorkbench meta={meta} />
      ) : meta.panel ? (
        <PanelWorkbench meta={meta} />
      ) : meta.input === 'file' ? (
        <FileWorkbench meta={meta} />
      ) : (
        <TextWorkbench meta={meta} />
      )
    }
  </div>

  {
    article && article.length > 0 && (
      <section class="prose-tool mt-14 max-w-prose" aria-labelledby="how-it-works-heading">
        <h2 id="how-it-works-heading">How it works</h2>
        {article.map((entry) => (
          <div>
            <h3>{entry.heading}</h3>
            <p>{entry.body}</p>
          </div>
        ))}
      </section>
    )
  }

  {
    faq && faq.length > 0 && (
      <section class="mt-14" aria-labelledby="questions-heading">
        <h2 id="questions-heading" class="text-lg font-bold text-[rgb(var(--text))]">
          Questions
        </h2>
        <div class="mt-4 divide-y overflow-hidden rounded-lg border">
          {faq.map((f) => (
            <details class="group px-4 py-4">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-[rgb(var(--text))]">
                <span>{f.q}</span>
                <Icon
                  name="chevron-down"
                  size={16}
                  class="shrink-0 transition-transform group-open:rotate-180"
                />
              </summary>
              <p class="mt-2 max-w-prose text-sm leading-relaxed text-[rgb(var(--text-muted))]">
                {f.a}
              </p>
            </details>
          ))}
        </div>
      </section>
    )
  }

  {
    article == null && (
      <section class="prose-tool mt-14 max-w-prose">
        <h2>How it works</h2>
        <p>
          {meta.name} runs entirely in your browser tab. Your input is processed by JavaScript
          {meta.input === 'file' ? ' and, for large files, a background Web Worker' : ''} on this
          device. Nothing is uploaded, and the page works offline once it has loaded.
        </p>
        {meta.privacy.network !== 'none' && (
          <p>
            Network use: this tool may contact{' '}
            {(meta.privacy.network as string[]).map((n) => (
              <code>{n}</code>
            ))}
            . See the <a href={`${base}/privacy`}>privacy model</a>.
          </p>
        )}
        {meta.credits && meta.credits.length > 0 && (
          <>
            <h3>Built with</h3>
            <ul>
              {meta.credits.map((c) => (
                <li>
                  <a href={c.url} rel="noopener">
                    {c.name}
                  </a>{' '}
                  · {c.license}
                </li>
              ))}
            </ul>
          </>
        )}
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="mt-14" aria-labelledby="related-heading">
        <div class="flex items-center justify-between gap-4">
          <h2 id="related-heading" class="text-lg font-bold text-[rgb(var(--text))]">
            Related tools
          </h2>
          <a
            class="text-sm font-medium text-[rgb(var(--accent))] hover:underline"
            href={`${base}/categories/${category.id}`}
          >
            See category
          </a>
        </div>
        <ul class="mt-4 flex flex-wrap gap-2">
          {related.map((t) => (
            <li>
              <a
                class="chip transition-colors hover:text-[rgb(var(--text))] hover:underline"
                href={`${base}/tools/${t.meta.id}`}
              >
                {t.meta.name}
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          {related.map((t) => (
            <ToolCard meta={t.meta} showCategory />
          ))}
        </div>
      </section>
    )
  }
</article>

<script>
  import { recordRecentTool } from '@/lib/recent-tools';

  const article = document.querySelector<HTMLElement>('article[data-tool-id]');
  const { toolId, toolName, toolHref } = article?.dataset ?? {};
  if (toolId && toolName && toolHref) {
    recordRecentTool(window.localStorage, { id: toolId, name: toolName, href: toolHref });
  }
</script>
